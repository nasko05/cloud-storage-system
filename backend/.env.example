# Backend configuration (prefix: DRIVE_). Copy to .env for local runs.
# All values have sensible defaults; only DRIVE_SECRET_KEY matters in prod.

# Secret used to sign JWTs and blob URLs. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
DRIVE_SECRET_KEY=change-me

# Database. SQLite for quick local dev; PostgreSQL for real deployments.
# DRIVE_DATABASE_URL=sqlite:///./data/app.db
# DRIVE_DATABASE_URL=postgresql+psycopg2://drive:drive@localhost:5432/drive

# Where uploaded file bytes are stored.
DRIVE_STORAGE_DIR=./data/blobs

# Comma-separated allowed CORS origins (use specific origins in production).
DRIVE_CORS_ALLOW_ORIGINS=*

# Token / session tuning.
# DRIVE_ACCESS_TOKEN_EXPIRY_MINUTES=1440
# DRIVE_SIGNED_URL_EXPIRY_SECONDS=3600
# DRIVE_SHARE_EXPIRY_DAYS=30

# Require email confirmation on registration (no mailer is bundled; the code
# is printed to the server log). Defaults to false for self-hosting.
# DRIVE_REQUIRE_EMAIL_CONFIRMATION=false

# Per-user storage quota in bytes (0 = unlimited).
# DRIVE_USER_QUOTA_BYTES=0

# Login brute-force protection.
# DRIVE_LOGIN_MAX_ATTEMPTS=5
# DRIVE_LOGIN_WINDOW_SECONDS=300
# DRIVE_LOGIN_LOCKOUT_SECONDS=900

# Backups (a daily scheduler writes verified bundles to DRIVE_BACKUP_DIR).
# DRIVE_BACKUP_DIR=./data/backups
# DRIVE_BACKUP_INTERVAL_HOURS=24
# DRIVE_BACKUP_RETENTION=10

# Optional antivirus (ClamAV over TCP). Disabled by default.
# DRIVE_CLAMAV_ENABLED=false
# DRIVE_CLAMAV_HOST=clamav
# DRIVE_CLAMAV_PORT=3310

# Apply Alembic migrations on startup (production). Tests set this to false.
# DRIVE_RUN_MIGRATIONS=true
